{
  "apiVersion": "orchestration.misaka.dev/v1",
  "kind": "Workflow",
  "metadata": {
    "id": "real-codex-addition",
    "version": 1,
    "name": "Real Codex addition task"
  },
  "spec": {
    "flow": {
      "type": "dag"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "formula": {
          "type": "string"
        },
        "result": {
          "type": "integer"
        },
        "report_path": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "formula",
        "result",
        "report_path",
        "request_id"
      ],
      "additionalProperties": false
    },
    "failurePolicy": "fail_fast",
    "maxConcurrency": 1,
    "nodes": [
      {
        "id": "calculate_and_write",
        "type": "agent",
        "typeVersion": 1,
        "inputs": [
          {
            "name": "request_id",
            "expression": "workflow.input.request_id"
          }
        ],
        "outputSchema": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string"
            },
            "result": {
              "type": "integer"
            },
            "report_path": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "formula",
            "result",
            "report_path",
            "request_id"
          ],
          "additionalProperties": false
        },
        "agent": {
          "provider": "codex",
          "model": "sensenova/deepseek-v4-flash",
          "effort": "high",
          "workspaceId": "aitools",
          "access": "workspace_write",
          "approvalMode": "deny_all",
          "networkPolicy": "agent_default",
          "allowedToolProfile": "coding-default",
          "sessionMode": "new",
          "instruction": "This is a bounded user acceptance task. Work only in the current isolated Git worktree. Read the integer in multi-agent-v2/examples/real_user_test/input/left.txt and the integer in multi-agent-v2/examples/real_user_test/input/right.txt. Calculate their sum. Create or replace multi-agent-v2/examples/real_user_test/output/result.md containing a title, the request_id from the resolved task inputs, and the complete addition formula. Do not modify any other file. After verifying the report, return exactly one JSON object matching the output schema: formula must be the complete formula, result must be the integer sum, report_path must be multi-agent-v2/examples/real_user_test/output/result.md, and request_id must equal the resolved input.",
          "timeout": "PT10M",
          "retry": {
            "maximumAttempts": 1
          }
        }
      }
    ],
    "transitions": [],
    "outputs": [
      {
        "name": "formula",
        "expression": "nodes.calculate_and_write.output.formula"
      },
      {
        "name": "result",
        "expression": "nodes.calculate_and_write.output.result"
      },
      {
        "name": "report_path",
        "expression": "nodes.calculate_and_write.output.report_path"
      },
      {
        "name": "request_id",
        "expression": "nodes.calculate_and_write.output.request_id"
      }
    ]
  }
}
